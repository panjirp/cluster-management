# Production environment — VPS
# Copy ini ke .env.production di VPS, atau set sebagai environment variables di VPS

# Database
POSTGRES_USER=barcelona
POSTGRES_PASSWORD=<GANTI_DENGAN_PASSWORD_AMAN>
POSTGRES_DB=barcelonacove

# NextAuth
NEXTAUTH_URL=https://www.barcelonacove.web.id
NEXTAUTH_SECRET=<GENERATE_DENGAN_openssl_rand_base64_32>

# Cron
CRON_SECRET=<GENERATE_DENGAN_openssl_rand_base64_32>

# Mayar Payment Gateway (pakai sandbox dulu, nanti ganti production)
MAYAR_API_KEY=<API_KEY_ANDA_DARI_https://mayar.id>

# Uploads (optional — jika pakai Netlify Blobs untuk storage bukti pembayaran)
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=

# Fonnte WhatsApp Gateway (opsional — untuk pengingat iuran via WhatsApp)
FONNTE_TOKEN=<TOKEN_DARI_https://fonnte.com>
