DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barcelonacove?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Bearer token checked by app/api/cron/event-reminders — call that route on a
# schedule (e.g. cron, GitHub Actions, Vercel Cron) to send H-1 event reminders.
CRON_SECRET="replace-with-a-random-secret"

# Mayar Payment Gateway — get your API key at https://mayar.id
MAYAR_API_KEY="replace-with-your-mayar-api-key"
