# ============================================================
#  .env.production — salin menjadi .env di VPS lalu isi nilainya
#  JANGAN commit file .env ini ke git!
# ============================================================

# --- Database (dipakai oleh container db & app) ---
POSTGRES_USER=barcelona
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=barcelonacove

# --- Aplikasi ---
NEXTAUTH_URL=https://barcelonacove.web.id
# Hasilkan dengan: openssl rand -base64 32  (minimal 32 karakter)
NEXTAUTH_SECRET=ganti-dengan-random-secret-panjang

# Secret untuk cron event-reminders (opsional)
CRON_SECRET=ganti-dengan-random-secret

# API Key Mayar / Lynx (opsional untuk pembayaran online)
MAYAR_API_KEY=

# --- Upload file via Netlify Blobs (opsional, kosongkan jika tidak dipakai) ---
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=
