// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  WARGA
  ADMIN
  BENDAHARA
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplaintCategory {
  FASILITAS
  KEAMANAN
  KEBISINGAN
  KEBERSIHAN
  LAINNYA
}

enum PermitType {
  RENOVASI
  ACARA
  TAMU_KENDARAAN
  SURAT_PENGANTAR
  LAINNYA
}

enum HouseStatus {
  DITEMPATI
  KOSONG
  DIKONTRAKKAN
}

enum DirectoryRole {
  PENGURUS
  SATPAM
}

enum ShiftStatus {
  PAGI
  SIANG
  MALAM
  OFF
}

enum RsvpStatus {
  GOING
  NOT_GOING
}

enum EmergencyStatus {
  OPEN
  RESOLVED
}

enum PermitStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  IURAN_BULANAN
  DONASI
  DANA_SOSIAL
  KEAMANAN
  KEBERSIHAN
  OPERASIONAL
  PERBAIKAN
  ACARA
  INVENTARIS
  ADMINISTRASI
  LAINNYA
}

enum ResidencyStatus {
  PEMILIK
  KONTRAK
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  passwordHash       String
  mustChangePassword Boolean          @default(false)
  role               Role             @default(WARGA)
  phone              String?
  houseId            String?
  house              House?           @relation(fields: [houseId], references: [id])
  residencyStatus    ResidencyStatus?
  emergencyPin       String?
  complaints         Complaint[]
  permits            Permit[]
  events             Event[]
  rsvps              EventRSVP[]
  notifications      Notification[]
  chatMessages       GroupChatMessage[]
  paymentProofs      PaymentProof[]
  reviewedProofs     PaymentProof[] @relation("ReviewedPaymentProof")
  deviceTokens       DeviceToken[]
  webPushSubscriptions WebPushSubscription[]
  guestPasses        GuestPass[]
  parcels            Parcel[]
  polls              Poll[]
  pollVotes          PollVote[]
  galleryPhotos      GalleryPhoto[]
  galleryLikes       GalleryLike[]
  galleryComments    GalleryComment[]
  marketListings     MarketListing[]
  sentMessages       DirectMessage[] @relation("DmSender")
  receivedMessages   DirectMessage[] @relation("DmRecipient")
  coveCoinLedger     CoveCoinLedger[]
  children           Child[]
  verifiedChildren   Child[]        @relation("VerifiedChildren")
  posyanduSchedules   PosyanduSchedule[]
  childCheckups      ChildCheckup[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model DeviceToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WebPushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  body        String
  url         String?
  read        Boolean  @default(false)
  broadcastId String?  // grup unik utk notif broadcast (utk statistik siapa yang sudah baca)
  createdAt   DateTime @default(now())

  @@index([userId, read])
  @@index([broadcastId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorName   String
  action      String
  description String
  createdAt   DateTime @default(now())
}

// ── CoveCoin (ekonomi lokal) ──
model CoveCoinLedger {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  amount      Int      // + = earn, - = spend/redeem
  type        String   @default("EARN") // EARN, REDEEM, ADJUST
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Akses Kendaraan (ANPR / boomgate) ──
model VehicleRegistration {
  id          String   @id @default(cuid())
  house       House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId     String
  plateNumber String
  vehicleType String   @default("MOBIL") // MOBIL, MOTOR
  ownerName   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([plateNumber])
  @@index([houseId])
}

model VehicleAccess {
  id          String   @id @default(cuid())
  plateNumber String
  direction   String   @default("MASUK") // MASUK, KELUAR
  houseId     String?
  house       House?   @relation(fields: [houseId], references: [id])
  isRegistered Boolean @default(false)
  status      String   @default("DIBUKA") // DIBUKA, DITOLAK
  gateName    String?
  createdAt   DateTime @default(now())

  @@index([plateNumber, createdAt])
  @@index([createdAt])
}

model House {
  id           String       @id @default(cuid())
  blockNumber  String       @unique
  statusHuni   HouseStatus  @default(DITEMPATI)
  contactPhone String?
  // Nama warga tercatat dari sumber data eksternal (mis. sheet iuran), tidak
  // mengharuskan warga tersebut punya akun login di aplikasi ini.
  residentName String?
  mapX         Float?
  mapY         Float?
  residents    User[]
  chatMessages GroupChatMessage[]
  monthlyDues  MonthlyDue[]
  guestPasses  GuestPass[]
  parcels      Parcel[]
  vehicleRegistrations VehicleRegistration[]
  vehicleAccesses VehicleAccess[]
  createdAt    DateTime     @default(now())
}

model Complaint {
  id          String            @id @default(cuid())
  title       String
  description String
  category    ComplaintCategory
  status      ComplaintStatus   @default(OPEN)
  response    String?
  photoUrl    String?
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?
}

model Permit {
  id                 String         @id @default(cuid())
  type               PermitType
  title              String
  description        String
  startDate          DateTime?
  endDate            DateTime?
  status             PermitStatus   @default(PENDING)
  adminNotes         String?
  supportingDocUrl   String?
  neighborConsentUrl String?
  finalDocUrl        String?
  createdBy          User           @relation(fields: [createdById], references: [id])
  createdById        String
  assetBookings      AssetBooking[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  decidedAt          DateTime?
}

model Asset {
  id       String         @id @default(cuid())
  name     String         @unique
  bookings AssetBooking[]
}

model AssetBooking {
  id         String   @id @default(cuid())
  asset      Asset    @relation(fields: [assetId], references: [id])
  assetId    String
  permit     Permit   @relation(fields: [permitId], references: [id])
  permitId   String
  borrowDate DateTime
  returnDate DateTime
  createdAt  DateTime @default(now())
}

model DirectoryMember {
  id            String        @id @default(cuid())
  roleType      DirectoryRole
  position      String
  fullName      String
  phone         String
  photoUrl      String?
  scheduleShift ShiftStatus?
  createdAt     DateTime      @default(now())
}

enum CameraStreamType {
  IFRAME
  HLS
}

model Camera {
  id         String           @id @default(cuid())
  name       String
  location   String?
  streamUrl  String
  streamType CameraStreamType @default(IFRAME)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String
  eventDate   DateTime
  location    String?
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdById String
  rsvps       EventRSVP[]
  durationMinutes Int?
  cost            Int?
  galleryPhotos GalleryPhoto[]
  createdAt   DateTime    @default(now())
}

model EventRSVP {
  id            String     @id @default(cuid())
  event         Event      @relation(fields: [eventId], references: [id])
  eventId       String
  user          User       @relation(fields: [userId], references: [id])
  userId        String
  status        RsvpStatus
  reminderSent  Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@unique([eventId, userId])
}

model CashTransaction {
  id          String              @id @default(cuid())
  type        TransactionType
  category    TransactionCategory
  amount      Int
  description String?
  date        DateTime            @default(now())
  importKey   String?             @unique
  createdAt   DateTime            @default(now())
}

model MonthlyDue {
  id        String    @id @default(cuid())
  house     House     @relation(fields: [houseId], references: [id])
  houseId   String
  year      Int
  month     Int
  amount    Int
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  paymentProofUrl String?
  mayarInvoiceId  String?   @unique   // Mayar invoice id for online payments
  paymentProofs PaymentProof[]
  createdAt DateTime  @default(now())

  @@unique([houseId, year, month])
}

model PaymentProof {
  id             String    @id @default(cuid())
  monthlyDue     MonthlyDue @relation(fields: [monthlyDueId], references: [id], onDelete: Cascade)
  monthlyDueId   String
  submittedBy    User      @relation(fields: [submittedById], references: [id])
  submittedById  String
  fileName       String
  filePath       String
  fileSize       Int
  mimeType       String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy     User?     @relation("ReviewedPaymentProof", fields: [reviewedById], references: [id])
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime  @default(now())

  @@index([monthlyDueId])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
}

model Setting {
  id                   String  @id @default("singleton")
  duesAmount           Int     @default(150000)
  cashSheetUrl         String?
  duesSheetUrl         String?
  emergencyNotifyPhone String?
  gatePin              String? @default("0000")
  // Whitelist akses "Iuran Kas" utk warga — JSON array blockNumber, mis. ["BC3-22"]
  duesAccessHouseIds   String?
}

model EmergencyAlert {
  id          String            @id @default(cuid())
  userId      String
  userName    String
  houseBlock  String
  message     String?
  status      EmergencyStatus   @default(OPEN)
  resolvedBy  String?
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
}

model GroupChatMessage {
  id        String   @id @default(cuid())
  houseId   String?
  house     House?   @relation(fields: [houseId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Jual Beli Warga ──
model MarketListing {
  id          String      @id @default(cuid())
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId    String
  title       String
  description String?
  price       Int?
  category    String      @default("LAINNYA") // BARANG, JASA, MAKANAN, LAINNYA
  imagePath   String?
  status      String      @default("AKTIF") // AKTIF, TERJUAL
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}

// ── Pesan Langsung (DM) antar warga ──
model DirectMessage {
  id          String    @id @default(cuid())
  sender      User      @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  recipient   User      @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  content     String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, read])
}

model SuratEdaran {
  id          String   @id @default(cuid())
  title       String
  filePath    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ===== QR Pass Tamu =====

enum GuestPassStatus {
  ACTIVE
  USED
  REVOKED
}

enum VehicleType {
  MOBIL
  MOTOR
  LAINNYA
}

model GuestPass {
  id          String          @id @default(cuid())
  code        String          @unique // kode pendek utk input manual satpam, mis. BC-4F7A
  host        User            @relation(fields: [hostId], references: [id])
  hostId      String
  house       House?          @relation(fields: [houseId], references: [id])
  houseId     String?
  guestName   String
  guestPhone  String?
  vehicleType VehicleType     @default(MOTOR)
  plateNumber String?
  purpose     String
  validUntil  DateTime
  status      GuestPassStatus @default(ACTIVE)
  scannedAt   DateTime?
  scannedBy   String?
  createdAt   DateTime        @default(now())

  @@index([hostId])
  @@index([status, validUntil])
}

// ===== Titip Paket =====

enum ParcelStatus {
  WAITING
  PICKED_UP
}

model Parcel {
  id           String       @id @default(cuid())
  house        House?       @relation(fields: [houseId], references: [id])
  houseId      String?
  resident     User?        @relation(fields: [residentId], references: [id])
  residentId   String?
  courierName  String
  senderName   String?
  description  String?
  photoUrl     String?
  status       ParcelStatus @default(WAITING)
  pickedUpAt   DateTime?
  loggedBy     String       @default("Pos Satpam")
  loggedByAdminId String?
  createdAt    DateTime     @default(now())

  @@index([houseId])
  @@index([residentId])
  @@index([status])
}

// ===== Polling Warga =====

model Poll {
  id          String       @id @default(cuid())
  title       String
  question    String
  isMultiple  Boolean      @default(false)
  endsAt      DateTime?
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdById String
  options     PollOption[]
  createdAt   DateTime     @default(now())
}

model PollOption {
  id      String     @id @default(cuid())
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId  String
  label   String
  sort    Int        @default(0)
  votes   PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
  @@index([userId])
}

// ===== Galeri Acara =====

model GalleryPhoto {
  id           String   @id @default(cuid())
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String?
  filePath     String
  caption      String?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())
  likes        GalleryLike[]
  comments     GalleryComment[]

  @@index([eventId])
}

model GalleryLike {
  id        String       @id @default(cuid())
  photo     GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime     @default(now())

  @@unique([photoId, userId])
  @@index([photoId])
}

model GalleryComment {
  id        String       @id @default(cuid())
  photo     GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  createdAt DateTime     @default(now())

  @@index([photoId])
}

// ── Posyandu Anak ──

model Child {
  id            String   @id @default(cuid())
  userId        String
  parent        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  birthDate     DateTime
  gender        String   // LAKI_LAKI or PEREMPUAN
  birthWeight   Float?   // kg
  birthLength   Float?   // cm
  nik           String?
  allergies     String?
  photoUrl      String?
  immunizationsDone String[] @default([]) // imunisasi yang sudah diterima saat daftar
  vitamins      String?  // vitamin yang sudah diterima
  notes         String?  // keterangan tambahan dari warga
  isVerified    Boolean  @default(false)
  verifiedBy    User?    @relation("VerifiedChildren", fields: [verifiedById], references: [id])
  verifiedById  String?
  createdAt     DateTime @default(now())

  checkups      ChildCheckup[]

  @@index([userId])
  @@index([verifiedById])
}

model PosyanduSchedule {
  id        String   @id @default(cuid())
  date      DateTime
  time      String   // HH:mm
  location  String   @default("Posko Barcelona Cove")
  notes     String?
  createdBy User     @relation(fields: [createdById], references: [id])
  createdById String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  checkups  ChildCheckup[]

  @@index([date])
}

model ChildCheckup {
  id                  String   @id @default(cuid())
  child               Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId             String
  schedule            PosyanduSchedule? @relation(fields: [scheduleId], references: [id])
  scheduleId          String?
  date                DateTime @default(now())

  weight              Float?   // kg
  height              Float?   // cm
  headCircumference   Float?   // cm

  nutritionalStatus   String?  // GIZI_BAIK, GIZI_KURANG, GIZI_BURUK, GIZI_LEBIH
  immunizationGiven   String[] // array vaksin diberikan: ["BCG","POLIO_1",...]
  vitaminA            Boolean? // true = ya
  notes               String?

  recordedBy          User     @relation(fields: [recordedById], references: [id])
  recordedById        String
  createdAt           DateTime @default(now())

  @@index([childId])
  @@index([scheduleId])
  @@index([date])
}
